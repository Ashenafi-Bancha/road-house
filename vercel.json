{
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "has": [{ "type": "header", "key": "accept-language", "value": "^am.*" }], "destination": "/am/", "permanent": false },
    { "source": "/", "destination": "/en/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
